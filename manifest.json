{
  "name": "Masjid Finder - Cari Tempat Ibadah Terdekat",
  "short_name": "MasjidFinder",
  "description": "Aplikasi PWA untuk menemukan lokasi masjid, mushola, langgar, dan surau terdekat di sekitar Anda.",
  "id": "/",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#0f766e",
  "lang": "id",
  "dir": "ltr",
  "categories": ["utilities", "navigation", "lifestyle"],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/pointhi/kml-icon-colr/master/icons/place_of_worship/islamic.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "https://raw.githubusercontent.com/pointhi/kml-icon-colr/master/icons/place_of_worship/islamic.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "https://via.placeholder.com/1280x720/0f766e/ffffff?text=Masjid+Finder+Desktop",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tampilan Desktop Masjid Finder"
    },
    {
      "src": "https://via.placeholder.com/750x1334/0f766e/ffffff?text=Masjid+Finder+Mobile",
      "sizes": "750x1334",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Tampilan Mobile Masjid Finder"
    }
  ],
  "shortcuts": [
    {
      "name": "Cari Terdekat",
      "short_name": "Terdekat",
      "description": "Temukan masjid terdekat dari posisi Anda saat ini",
      "url": "./index.html?action=nearest",
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/pointhi/kml-icon-colr/master/icons/place_of_worship/islamic.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [".json"],
        "application/vnd.google-earth.kml+xml": [".kml"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "related_applications": [],
  "prefer_related_applications": false
}
